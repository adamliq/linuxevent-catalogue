[
  {
    "path": "/etc/fapolicyd/fapolicyd.conf",
    "purpose": "Daemon configuration"
  },
  {
    "path": "/etc/fapolicyd/rules.d/",
    "purpose": "Source rule files (numbered, concatenated at daemon start)"
  },
  {
    "path": "/etc/fapolicyd/compiled.rules",
    "purpose": "Compiled rules the daemon actually evaluates (generated)"
  },
  {
    "path": "/etc/fapolicyd/fapolicyd.trust",
    "purpose": "File-based trust list (used when trust = file in fapolicyd.conf)"
  },
  {
    "path": "/etc/fapolicyd/trust.d/",
    "purpose": "Additional named trust files"
  },
  {
    "path": "/var/log/fapolicyd-access.log",
    "purpose": "Startup/shutdown usage statistics report (do_stat_report)"
  },
  {
    "path": "/var/run/fapolicyd.state",
    "purpose": "Internal statistics dump (SIGUSR1)"
  }
]
